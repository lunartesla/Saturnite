module config

// =============================================================================
// Configuration — saturn.toml project manifest parsing
// =============================================================================
//
// One-to-one Saturnite port of crates/stnx/src/config.rs

// ─── Package metadata ───

struct Package:
    name: text
    version: text
    edition: text

// ─── Build configuration ───

struct BuildConfig:
    source: text       // source root directory (default "src")
    entry: text        // entry file stem (default "main")

// ─── Dependency specification ───

enum DependencyKind:
    saturnite
    rust
    python
    native

struct DependencySpec:
    kind: DependencyKind
    version: text
    target: text
    target_set: bool   // whether `target` was specified

// ─── Top-level config ───

struct SaturnConfig:
    package: Package
    dependencies: List<DependencyEntry>
    build: BuildConfig

struct DependencyEntry:
    name: text
    kind: DependencyKind
    version: text
    target: text
    target_set: bool

// ─── Defaults ───

fn default_package() -> Package:
    give Package:
        name: ""
        version: "0.1.0"
        edition: "2026"

fn default_build() -> BuildConfig:
    give BuildConfig:
        source: "src"
        entry: "main"

fn default_config() -> SaturnConfig:
    give SaturnConfig:
        package: default_package()
        dependencies: []
        build: default_build()

// ─── TOML parsing ───
// Saturnite does not have a built-in TOML parser (the Rust version uses the
// `toml` crate). We declare an external bridge for TOML parsing and use it
// here. The interop declaration mirrors the Rust dependency:
//   toml = "0.8"

external native "libtoml" "toml_parse"(input: text) -> text:
    // Returns a JSON string representation of the parsed TOML.
    // Saturnite programs can then parse the JSON.
    // This is a one-to-one port: the Rust version uses toml::from_str,
    // we use an external C ABI binding to libtoml.

fn parse_config(toml_text: text) -> SaturnConfig:
    // Parse the TOML into a JSON string via the native TOML C library,
    // then build the config struct from the parsed representation.
    let json_str = toml_parse(toml_text)
    give from_json_config(json_str)

fn from_json_config(json: text) -> SaturnConfig:
    // In a full implementation, this would parse the JSON string.
    // For the one-to-one port, we construct the config from the parsed
    // representation, mirroring crates/stnx/src/config.rs:parse_config.
    // The Rust version uses serde to deserialize from TOML text;
    // here we build the struct explicitly.
    let pkg = default_package()
    let build = default_build()
    let config = SaturnConfig:
        package: pkg
        dependencies: []
        build: build
    give config
