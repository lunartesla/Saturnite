// Saturnite 0.5 native syntax example.
// Exercises: module, struct, functions, give, say, raise,
// if/else, for, named args, string literals, main block.

module inventory_demo

struct Item:
    name: text
    price: number
    quantity: number

fn total_value(price: number, qty: number) -> number:
    give price * qty

fn restock(price: number, amount: number) -> number:
    if amount <= 0:
        raise "restock amount must be positive"
    give price + amount

fn add(a: number, b: number) -> number:
    give a + b

main:
    let w = total_value(4, 10)
    let x = total_value(2, 25)
    let y = restock(4, 20)
    let z = add(1, b: 2)
    say w
    say x
    say y
    say z
    for i in 0..3:
        say i
    give w
